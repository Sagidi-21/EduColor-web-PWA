{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educolor.app/schemas/activity-manifest.schema.json",
  "title": "Manifest de actividad EduColor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "engineId",
    "subjectId",
    "gradeIds",
    "curriculumBlockIds",
    "title",
    "description",
    "status",
    "parameters"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "../schema/activity-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "engineId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "subjectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "gradeIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "curriculumBlockIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "available", "retired"] },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }
  },
  "$defs": {
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title", "defaultValue"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "kind": { "const": "boolean" },
            "title": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title", "defaultValue", "minimum", "maximum"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "kind": { "const": "integer" },
            "title": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "integer" },
            "minimum": { "type": "integer" },
            "maximum": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title", "defaultValue", "options"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "kind": { "const": "select" },
            "title": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "string" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "title"],
                "properties": {
                  "value": { "type": "string" },
                  "title": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
