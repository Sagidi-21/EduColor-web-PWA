# Hugging Face token — required for mascot image generation (free tier available)
# Get your token from https://huggingface.co/settings/tokens (Settings > Access Tokens > New token > Read access)
HF_TOKEN=

# Supabase (colegios + profesorado; D-028). Use Publishable key, never Secret key.
# URL = https://<project-reference>.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Playwright E2E (opcional). Sin estas vars, solo corre el smoke de acceso.
# E2E_BASE_URL=http://127.0.0.1:5173
# E2E_OWNER_EMAIL=
# E2E_OWNER_PASSWORD=

# --- Solo en Supabase Edge Secrets (NO en Netlify ni en el cliente) ---
# Avisos ops de lockout (D16). Guía: docs/OPS_ALERTS_RESEND.md
# RESEND_API_KEY=re_...
# OPS_ALERT_EMAILS=salvadorginestarhernadez@gmail.com,sagidiappcursor@gmail.com
