{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "outDir": "dist/server",
    "rootDir": "src/server",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/server"],
  "exclude": ["node_modules", "dist"]
}
